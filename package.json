{
  "name": "thoughtline-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Thoughtline Chrome extension and product website workspace.",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm dev:extension",
    "dev:extension": "pnpm --filter @thoughtline/extension dev",
    "dev:web": "pnpm --filter @thoughtline/web dev",
    "build:extension": "pnpm --filter @thoughtline/extension build",
    "build:web": "pnpm --filter @thoughtline/web build",
    "build": "pnpm build:extension && pnpm build:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @thoughtline/extension lint && pnpm --filter @thoughtline/web lint",
    "typecheck": "pnpm --filter @thoughtline/extension typecheck && pnpm --filter @thoughtline/web typecheck",
    "test": "pnpm --filter @thoughtline/extension test",
    "test:e2e": "pnpm --filter @thoughtline/extension test:e2e",
    "test:visual": "pnpm --filter @thoughtline/extension test:visual",
    "test:prototype": "pnpm --filter @thoughtline/extension test:prototype",
    "test:journey": "pnpm --filter @thoughtline/extension test:journey",
    "test:ai": "pnpm --filter @thoughtline/extension test:ai",
    "test:ai:live": "pnpm --filter @thoughtline/extension test:ai:live",
    "check:extension": "pnpm --filter @thoughtline/extension check",
    "check:web": "pnpm --filter @thoughtline/web check",
    "check:ui": "pnpm --filter @thoughtline/extension check:ui",
    "check": "pnpm format:check && pnpm check:extension && pnpm check:web",
    "release:zip": "pnpm --filter @thoughtline/extension release:zip"
  },
  "lint-staged": {
    "apps/extension/**/*.{ts,tsx,js,mjs}": "pnpm --filter @thoughtline/extension exec eslint --fix",
    "apps/web/**/*.{ts,tsx,js,mjs}": "pnpm --filter @thoughtline/web exec eslint --fix",
    "*.{json,md,html,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.9.5"
  }
}
